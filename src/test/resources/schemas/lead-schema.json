{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CrmLead",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "full_name", "email", "phone", "lead_status"],
    "properties": {
      "id": { "type": "string" },
      "full_name": { "type": "string" },
      "email": { "type": "string" },
      "phone": { "type": "string" },
      "lead_status": { 
        "type": "string",
        "enum": ["new_lead", "contacted", "interested", "counseling", "payment_pending", "enrolled", "lost"]
      }
    },
    "additionalProperties": true
  }
}